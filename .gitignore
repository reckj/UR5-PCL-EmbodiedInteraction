# URSim writes programs/installations here; keep the folder, not its contents
programs/*
!programs/.gitkeep

# Students' own work folders (students/<name>/) are not part of this repo
students/*
!students/README.md

# local config (optional VIEWER_SCENE etc.)
.env

# taught workspace(s) — one per setup, not shared
workspace*.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
